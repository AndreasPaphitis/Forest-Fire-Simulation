{
  "config_name": "Massive Grid No Terrain Test",
  "config_version": "1.0",
  "description": "Configuration for massive grid (21.5M cells) without terrain loading to avoid bottlenecks",
  
  "simulation": {
    "max_steps": 100,
    "random_seed": 42,
    "debug": false,
    "store_full_states": false,
    "stop_when_fire_extinguished": true,
    "grid_size": [4788, 4490],
    "num_layers": 25,
    "layer_height": 2.0,
    "model_resolution": 5.0,
    
    "spread_probability": 0.6,
    "fuel_consumption_rate": 0.8,
    "ignition_threshold": 0.4,
    "min_fuel_value": 0.0,
    "max_fuel_value": 10.0,
    "initial_fuel_load": 8.0,
    "fuel_moisture_baseline": 0.2,
    
    "wind_speed": 5.0,
    "wind_direction": 45.0,
    "temperature": 25.0,
    "humidity": 0.4,
    "reference_wind_speed": 10.0,
    "wind_influence_on_spread": 0.3,
    
    "slope_influence": 0.0,
    "terrain_effect_strength": 0.0,
    "barranco_threshold": 0.0,
    "barranco_amplification": 1.0,
    "barranco_direction_weight": 0.0,
    "min_depression_depth": 0.0,
    "min_depression_area": 0,
    
    "ember_probability": 0.1,
    "ember_distance": 50.0,
    "ember_ignition": 0.3,
    "ember_height_factor": 0.5,
    "ember_rise": 0.2,
    "ember_wind_factor": 0.3,
    
    "memory_optimization_level": 3,
    "use_disk_storage": true,
    "use_sparse_storage": true,
    "disk_storage_dir": "temp_simulation_states",
    "bytes_per_cell": 30,
    "tile_size": 500,
    "chunk_size": 1000,
    
    "simulation_type": "memory_optimized",
    "output_dir": "test_output/massive_grid_no_terrain",
    "results_output_dir": "test_output/massive_grid_no_terrain/results",
    "logs_output_dir": "test_output/massive_grid_no_terrain/logs",
    "checkpoints_output_dir": "test_output/massive_grid_no_terrain/checkpoints",
    "monitoring_output_dir": "test_output/massive_grid_no_terrain/monitoring",
    "temp_storage_dir": "test_output/massive_grid_no_terrain/temp",
    
    "history_keyframe_interval": 10,
    "engine_logging_interval": 50,
    
    "geo_bounds": null,
    "crs": "EPSG:25828",
    
    "ignition_points": [[2394, 2245, 0]],
    
    "config_name": "Massive_Grid_No_Terrain_Test",
    "config_version": "1.0",
    
    "extinction_coefficient": 0.5,
    "pad_bin_size": 2.0,
    "exclude_ground_layer": true,
    
    "use_lidar": false,
    "auto_size_from_lidar": false,
    "lidar_data_dir": null,
    "max_grid_size": null,
    "max_vegetation_height_m": 50.0,
    
    "use_tiling": true,
    "use_parallel": true,
    "tile_overlap_ratio": 0.1,
    
    "fuel_load_method": "constant",
    
    "save_visualizations": false,
    
    "use_preprocessed_terrain": true,
    "preprocessed_terrain_dir": "preprocessed_terrain",
    
    "hpc_io_block_size": 8192,
    "hpc_memory_limit_per_node": 400.0,
    "hpc_mode_gdal": false,
    "gdal_cache_mb": 256,
    "gdal_thread_count": null,
    
    "reserve_cpus": 4
  },
  
  "calibration": {
    "parameter_space": {
      "spread_probability": [0.4, 0.6, 0.8],
      "fuel_consumption_rate": [0.6, 0.8, 1.0],
      "ember_probability": [0.05, 0.1, 0.15],
      "ember_ignition": [0.2, 0.3, 0.4],
      "fuel_moisture_baseline": [0.1, 0.2, 0.3]
    },
    
    "target_data": {
      "fire_perimeters": {
        "day_1": {
          "area_ha": 150.0,
          "perimeter_km": 5.2,
          "max_spread_distance_km": 2.1
        },
        "day_2": {
          "area_ha": 320.0,
          "perimeter_km": 8.7,
          "max_spread_distance_km": 3.8
        },
        "day_3": {
          "area_ha": 580.0,
          "perimeter_km": 12.3,
          "max_spread_distance_km": 5.2
        }
      }
    },
    
    "objective_weights": {
      "area_error": 0.4,
      "perimeter_error": 0.3,
      "spread_distance_error": 0.3
    },
    
    "validation_split": 0.2,
    "max_workers": 4,
    "timeout_seconds": 1800,
    "memory_limit_gb": 32.0,
    
    "output_dir": "test_output/massive_grid_no_terrain_results",
    "save_intermediate_results": true,
    "save_best_models": true,
    "save_parameter_importance": true,
    "save_sensitivity_analysis": true
  }
