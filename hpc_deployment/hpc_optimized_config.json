{
  "name": "HPC Optimized Forest Fire Calibration",
  "description": "Configuration optimized for HPC environments with automatic optimizations for network filesystem bottlenecks, memory bandwidth limitations, and garbage collection overhead",
  
  "grid": {
    "width": 5000,
    "height": 5000,
    "num_layers": 25,
    "cell_size": 5.0
  },
  
  "calibration": {
    "max_workers": "auto",
    "parallel_execution": true,
    "bypass_worker_limit": false,
    "parameter_bounds": {
      "wind_speed_factor": [0.5, 2.0],
      "fuel_moisture_baseline": [0.1, 0.5],
      "ignition_probability": [0.01, 0.1]
    }
  },
  
  "terrain": {
    "use_terrain": true,
    "preprocessed_dir": "preprocessed_terrain",
    "local_cache_dir": "auto",
    "cache_terrain_locally": true
  },
  
  "output": {
    "base_path": "auto",
    "save_results": true,
    "save_animations": false,
    "save_plots": true,
    "verbose": true
  },
  
  "monitoring": {
    "memory_bandwidth_monitoring": true,
    "memory_threshold_gb": "auto",
    "gc_optimization": true,
    "storage_optimization": true,
    "log_level": "INFO"
  },
  
  "hpc_optimizations": {
    "enabled": true,
    "network_filesystem_optimization": true,
    "memory_bandwidth_optimization": true,
    "garbage_collection_optimization": true,
    "numa_awareness": true,
    "local_storage_preference": true
  },
  
  "simulation": {
    "max_time_steps": 100,
    "time_step": 60,
    "ignition_points": [
      {
        "x": 2500,
        "y": 2500,
        "time": 0
      }
    ],
    "wind": {
      "speed": 10.0,
      "direction": 45.0
    },
    "weather": {
      "temperature": 25.0,
      "humidity": 0.4
    }
  },
  
  "memory_management": {
    "use_sparse_storage": true,
    "force_sparse_only": false,
    "memory_safety_factor": 0.8,
    "gc_thresholds": [100, 5, 5],
    "disable_gc_during_critical_sections": true
  },
  
  "storage_optimization": {
    "prefer_local_storage": true,
    "use_shared_memory_filesystem": true,
    "cache_terrain_data": true,
    "local_storage_candidates": [
      "/dev/shm",
      "/tmp",
      "/scratch",
      "/scratch-shared"
    ]
  },
  
  "performance": {
    "batch_size": 10,
    "timeout_seconds": 30,
    "retry_attempts": 3,
    "progress_reporting_interval": 10
  }
}
