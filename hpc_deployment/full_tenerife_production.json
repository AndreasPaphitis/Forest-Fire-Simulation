{
  "simulation_name": "full_tenerife_calibration",
  "description": "Production configuration for full Tenerife calibration - 9.3B cells",
  
  "grid_configuration": {
    "grid_size": [15121, 24741],
    "num_layers": 25,
    "layer_height_meters": 2.0,
    "model_resolution": 10.0,
    "comment": "Full Tenerife domain - 374M surface cells, 9.3B total cells"
  },
  
  "memory_optimization": {
    "memory_optimization_level": 2,
    "use_sparse_storage": true,
    "force_sparse_only": true,
    "use_shared_terrain": true,
    "shared_terrain_readonly": true,
    "max_memory_gb": 400,
    "enable_memory_monitoring": true,
    "memory_warning_threshold_gb": 350,
    "memory_critical_threshold_gb": 380,
    "enable_emergency_checkpointing": true,
    "comment": "Ultra-aggressive memory optimization for 9.3B cell grid"
  },
  
  "terrain_configuration": {
    "use_preprocessed_terrain": true,
    "preprocessed_terrain_dir": "preprocessed_terrain",
    "use_memory_mapping": true,
    "terrain_chunk_size": [2000, 2000],
    "cache_terrain_chunks": true,
    "max_cached_chunks": 10,
    "comment": "Memory-mapped terrain with chunked loading"
  },
  
  "simulation_parameters": {
    "max_timesteps": 2000,
    "timestep_minutes": 1.0,
    "save_interval": 100,
    "store_full_states": false,
    "use_differential_history": true,
    "checkpoint_interval": 500,
    "enable_adaptive_timestep": true,
    "comment": "Optimized for long-running calibration"
  },
  
  "fire_parameters": {
    "spread_rate": 0.5,
    "wind_speed_ms": 5.0,
    "wind_direction_degrees": 45.0,
    "moisture_content": 0.15,
    "initial_fuel_load": 2.0,
    "ignition_temperature": 350.0,
    "enable_ember_transport": true,
    "ember_range_meters": 500.0
  },
  
  "sparse_optimization": {
    "initial_active_fraction": 0.001,
    "max_active_fraction": 0.05,
    "sparse_threshold": 1e-6,
    "use_compressed_sparse": true,
    "sparse_matrix_format": "lil",
    "enable_sparse_gc": true,
    "gc_interval_steps": 50,
    "comment": "Ultra-sparse storage for 9.3B cell efficiency"
  },
  
  "output_configuration": {
    "output_dir": "full_tenerife_calibration_output",
    "export_formats": ["pickle", "hdf5"],
    "create_animations": false,
    "save_terrain_data": false,
    "compress_output": true,
    "output_precision": "float32",
    "save_sparse_format": true,
    "comment": "Minimal output to reduce I/O overhead"
  },
  
  "hpc_configuration": {
    "nodes": 4,
    "cores_per_node": 32,
    "memory_per_node_gb": 512,
    "max_runtime_hours": 24,
    "job_name": "tenerife_calibration_full",
    "partition": "highmem",
    "account": "research",
    "modules": ["Python/3.11.3-GCCcore-12.3.0"],
    "comment": "High-memory nodes required for full domain"
  },
  
  "calibration_specific": {
    "enable_memory_profiling": true,
    "profile_interval_steps": 100,
    "adaptive_worker_count": true,
    "max_workers_per_node": 8,
    "enable_worker_memory_limits": true,
    "worker_memory_limit_gb": 60,
    "comment": "Calibration-specific memory management"
  },
  
  "emergency_settings": {
    "enable_oom_protection": true,
    "memory_guardian_interval": 30,
    "auto_checkpoint_threshold_gb": 400,
    "emergency_shutdown_threshold_gb": 450,
    "shared_memory_cleanup_interval": 300,
    "enable_memory_alerts": true,
    "alert_email": null,
    "comment": "Emergency procedures for OOM prevention"
  },
  
  "advanced_features": {
    "enable_numa_optimization": true,
    "use_memory_pools": true,
    "pool_size_gb": 50,
    "enable_prefault": false,
    "use_huge_pages": true,
    "memory_affinity": "local",
    "comment": "Advanced HPC memory optimizations"
  }
}
