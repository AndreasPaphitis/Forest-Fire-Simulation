{
  "simulation_name": "memory_safe_forest_fire",
  "description": "Memory-optimized configuration to prevent OOM kills",
  
  "grid_configuration": {
    "grid_size": [2000, 2000],
    "num_layers": 15,
    "layer_height_meters": 2.0,
    "model_resolution": 10.0,
    "comment": "Reduced from 15121x24741 to prevent OOM - scale up gradually"
  },
  
  "memory_optimization": {
    "memory_optimization_level": 2,
    "use_sparse_storage": true,
    "use_shared_terrain": false,
    "max_memory_gb": 32,
    "enable_memory_monitoring": true,
    "comment": "Disabled shared terrain to prevent copy overhead"
  },
  
  "terrain_configuration": {
    "use_preprocessed_terrain": true,
    "preprocessed_terrain_dir": "preprocessed_terrain",
    "load_terrain_on_demand": true,
    "use_memory_mapping": true,
    "comment": "Use memory mapping to avoid loading full terrain into RAM"
  },
  
  "simulation_parameters": {
    "max_timesteps": 1000,
    "timestep_minutes": 1.0,
    "save_interval": 50,
    "store_full_states": false,
    "use_differential_history": true,
    "comment": "Reduced history storage to save memory"
  },
  
  "fire_parameters": {
    "spread_rate": 0.5,
    "wind_speed_ms": 5.0,
    "wind_direction_degrees": 45.0,
    "moisture_content": 0.15,
    "initial_fuel_load": 2.0,
    "ignition_temperature": 350.0
  },
  
  "output_configuration": {
    "output_dir": "memory_safe_output",
    "export_formats": ["pickle"],
    "create_animations": false,
    "save_terrain_data": false,
    "comment": "Minimal output to reduce I/O overhead"
  },
  
  "hpc_configuration": {
    "nodes": 1,
    "cores_per_node": 8,
    "memory_per_node_gb": 32,
    "max_runtime_hours": 2,
    "job_name": "memory_safe_fire_sim"
  },
  
  "emergency_settings": {
    "enable_oom_protection": true,
    "memory_warning_threshold_gb": 28,
    "auto_checkpoint_on_memory_pressure": true,
    "emergency_cleanup_interval_minutes": 15,
    "comment": "Emergency features to prevent OOM kills"
  }
}
